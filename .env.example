# Copy to .env to override the defaults. The apps and Docker Compose both read the root .env.
# Every value below is already the default, matching the services in compose.yaml.

# Apps
DATABASE_URL=postgres://edi_bridge:edi_bridge@localhost:5432/edi_bridge
REDIS_URL=redis://localhost:6379
API_PORT=3001
WORKER_HEALTH_PORT=3002

# Host ports of the Compose services (change these, and the URLs above, if a port is taken)
POSTGRES_PORT=5432
REDIS_PORT=6379
SFTP_PORT=2222
