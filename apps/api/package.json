{
  "name": "@edi-bridge/api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env src/seed-development.ts && tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "create-operator": "tsx --env-file-if-exists=../../.env src/create-operator.ts",
    "create-demo-workspaces": "tsx --env-file-if-exists=../../.env src/create-demo-workspaces.ts",
    "reset-sandbox": "tsx --env-file-if-exists=../../.env src/reset-sandbox.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@edi-bridge/channels": "workspace:*",
    "@edi-bridge/contracts": "workspace:*",
    "@edi-bridge/db": "workspace:*",
    "@edi-bridge/edifact": "workspace:*",
    "@edi-bridge/mapping": "workspace:*",
    "@edi-bridge/pipeline": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "ai": "^7.0.143",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.16",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.0.4",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@edi-bridge/oxlint-config": "workspace:*",
    "@edi-bridge/typescript-config": "workspace:*",
    "@edi-bridge/vitest-config": "workspace:*",
    "@types/node": "^24",
    "oxlint": "1.87.0",
    "testcontainers": "^12.2.1",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  }
}
