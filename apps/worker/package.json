    "test:watch": "vitest"
  },
  "dependencies": {
    "@edi-bridge/channels": "workspace:*",
    "@edi-bridge/db": "workspace:*",
    "@edi-bridge/pipeline": "workspace:*",
    "@effect/opentelemetry": "4.0.4",
    "@sentry/node": "^11.8.0",
    "bullmq": "^6.3.16",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.0.4",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@edi-bridge/oxlint-config": "workspace:*",
    "@edi-bridge/typescript-config": "workspace:*",
    "@edi-bridge/vitest-config": "workspace:*",
    "@types/node": "^24",
    "oxlint": "1.87.0",
    "testcontainers": "^12.2.1",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
