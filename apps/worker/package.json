{
  "name": "@edi-bridge/worker",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check-types": "tsc --noEmit",
