{
  "name": "@edi-bridge/web",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "NEXT_PUBLIC_API_MOCKING=enabled next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint && eslint",
    "lint:fix": "oxlint --fix && eslint --fix",
    "check-types": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@edi-bridge/contracts": "workspace:*",
    "@edi-bridge/mocks": "workspace:*",
    "@edi-bridge/ui": "workspace:*",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-query": "^5.104.1",
    "geist": "^1.7.2",
    "msw": "^3.0.2",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@edi-bridge/eslint-config": "workspace:*",
    "@edi-bridge/oxlint-config": "workspace:*",
    "@edi-bridge/typescript-config": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "eslint": "^10.12.0",
    "msw-storybook-addon": "^3.0.3",
    "oxlint": "1.87.0",
    "playwright": "^1.64.0",
    "storybook": "^10.6.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
