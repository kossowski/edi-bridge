{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "concurrency": "1",
  "futureFlags": {
    "githubActionsRemoteBaseRefFallback": true
  },
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "typegen": {
      "outputs": [".next/types/**"]
    },
    "lint": {
      "dependsOn": ["transit", "typegen"]
    },
    "lint:fix": {
      "dependsOn": ["transit", "typegen"],
      "cache": false
    },
    "check-types": {
      "dependsOn": ["transit", "typegen"]
    },
    "test": {
      "dependsOn": ["transit"],
      "passThroughEnv": ["CI", "DOCKER_HOST", "TESTCONTAINERS_*"]
    },
    "test:stories": {
      "dependsOn": ["transit"],
      "passThroughEnv": ["CI"]
    },
    "test:canvas": {
      "dependsOn": ["transit"],
      "passThroughEnv": ["CI"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:mutation": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "API_PORT",
        "WEB_ORIGIN",
        "WORKER_HEALTH_PORT",
        "RUN_REQUEUE_INTERVAL_SECONDS",
        "RUN_STUCK_AFTER_MINUTES",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "CHANNEL_SECRET_KEY",
        "NODE_ENV"
      ]
    },
    "test:e2e": {
      "dependsOn": ["transit"],
      "passThroughEnv": ["CI", "PLAYWRIGHT_*"]
    },
    "test:e2e:full-stack": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "PLAYWRIGHT_*",
        "WEB_PORT",
        "API_PORT",
        "OPERATOR_EMAIL",
        "OPERATOR_PASSWORD"
      ]
    },
    "build-storybook": {
      "dependsOn": ["transit"],
      "outputs": ["storybook-static/**"]
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "dev:mock": {
      "cache": false,
      "persistent": true
    }
  }
}
