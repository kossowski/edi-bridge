{
  "name": "edi-bridge",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:mock": "turbo run dev:mock",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "turbo run test:e2e",
    "storybook": "turbo run storybook",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "1.87.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "2.11.7"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.21.0 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.8.1 <13",
      "onFail": "warn"
    }
  }
}
