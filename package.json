{
  "name": "edi-bridge",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --concurrency=10",
    "dev:mock": "turbo run dev:mock --concurrency=10",
    "cli": "pnpm --silent --filter @edi-bridge/cli start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:stories": "turbo run test:stories",
    "test:watch": "turbo run test:watch --concurrency=10",
    "test:e2e": "turbo run test:e2e",
    "test:agent-hooks": "node --test '.claude/hooks/*.test.mjs'",
    "check:fast": "turbo run lint check-types test test:stories",
    "check": "turbo run lint check-types test test:stories test:canvas test:e2e build build-storybook --concurrency=1",
    "storybook": "turbo run storybook --concurrency=10",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "2.11.7"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.21.0 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.8.1 <13",
      "onFail": "warn"
    }
  }
}
